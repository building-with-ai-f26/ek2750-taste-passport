# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional settings. The defaults are Haiku + 1 web search (about $0.015 per user run).
#
# Which OpenRouter model to use (default: anthropic/claude-haiku-5.5)
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
#
# How many web searches the guide step may do (default: 1). Each search adds cost.
# WEB_SEARCH_MAX=1
#
# Turn web search off completely (picks then come from the model's memory only)
# WEB_SEARCH=off
#
# Alternative tested Nov 14: Sonnet + 1 search. Slightly better picks in some cities
# (e.g. Istanbul), about $0.11 per user run (about 7x Haiku + 1). To use it:
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# WEB_SEARCH_MAX=1
